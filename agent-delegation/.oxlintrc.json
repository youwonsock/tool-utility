{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import"
  ],
  "rules": {
    "no-control-regex": "off",
    "max-lines-per-function": [
      "error",
      {
        "max": 100
      }
    ],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": [
        "test/**"
      ],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "src/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./backends/*",
                  "!./backends/index.js"
                ],
                "message": "Core code reaches platform backends only through backends/index.js."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/index.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
