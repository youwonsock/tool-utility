{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:path-analysis-tools:v1:ObservationSet",
  "title": "ObservationSet",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "ObservationSet"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "create",
        "edit"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "samples": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "status": {
                              "enum": [
                                "estimated",
                                "unresolved",
                                "excluded"
                              ]
                            },
                            "position": {
                              "anyOf": [
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  },
                                  "minItems": 3,
                                  "maxItems": 3
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "frame_refs": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "uniqueItems": true
                            },
                            "protected": {
                              "type": "boolean"
                            },
                            "existing_ref": {
                              "type": "string",
                              "minLength": 1
                            },
                            "note": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "status",
                            "position",
                            "frame_refs"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "samples"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "segments"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "runs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "analysis_id",
    "frame_id",
    "mode",
    "targets"
  ],
  "additionalProperties": false
}
