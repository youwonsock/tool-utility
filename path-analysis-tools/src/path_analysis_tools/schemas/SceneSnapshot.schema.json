{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:path-analysis-tools:v1:SceneSnapshot",
  "title": "SceneSnapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "SceneSnapshot"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_transform": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 16,
      "maxItems": 16
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "externalRef": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "run",
              "segment",
              "point"
            ]
          },
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "owned": {
            "type": "boolean"
          },
          "external_reference_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "id",
          "externalRef",
          "kind",
          "parent_id",
          "label",
          "position",
          "owned",
          "external_reference_count"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "segments",
              "points"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "owner_id",
          "relation",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "scene_id",
    "scope_id",
    "frame_id",
    "frame_transform",
    "capabilities",
    "nodes",
    "orders"
  ],
  "additionalProperties": false
}
