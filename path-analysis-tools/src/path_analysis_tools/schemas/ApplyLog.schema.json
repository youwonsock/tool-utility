{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:path-analysis-tools:v1:ApplyLog",
  "title": "ApplyLog",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "ApplyLog"
    },
    "edit_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "externalRef": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "operation_id",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "edit_plan_id",
    "entries"
  ],
  "additionalProperties": false
}
